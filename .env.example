# Bitrix24: URL входящего вебхука без имени метода.
# Пример: https://example.bitrix24.ru/rest/1/abcdefghijklmnopqrstuvwxyz
BITRIX24_WEBHOOK_BASE=

# Необязательно. Если оставить пустым, адрес портала берется из URL вебхука.
# Пример: https://example.bitrix24.ru
BITRIX24_PORTAL_URL=https://forteprint.bitrix24.ru

# ID воронки продаж. Для основной воронки используйте 0.
BITRIX24_CATEGORY_ID=0

# Явные STAGE_ID пяти стадий через запятую. Скопируйте значения из Битрикс24.
# Для дополнительной воронки ID обычно имеют вид C7:UC_ABC123.
BITRIX24_STAGE_IDS=PREPAYMENT_INVOICE,UC_RYXEZ2,EXECUTING,FINAL_INVOICE,UC_G4P48R,WON

# ID берется из URL таблицы между /d/ и /edit.
GOOGLE_SPREADSHEET_ID=1awKZ2mzfMTHgeBy-FLuthyrx3JEtxPb4vrE2JnHxreA
GOOGLE_SHEET_NAME=Лист1
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-service-account.json

# Минимальный интервал между write-запросами Google.
# 1200 мс = максимум 50 запросов/минуту при лимите Google 60.
GOOGLE_WRITE_REQUEST_INTERVAL_MS=1200
# Общий файл координирует основной и менеджерский cron между процессами.
GOOGLE_WRITE_RATE_FILE=var/google-write-rate.lock

# Сделки распределяются по листам «Август 2026», «Сентябрь 2026» и т. д.
# По умолчанию месяц определяется по дате создания сделки.
MONTH_SOURCE_FIELD=createdTime

# Конфигурация отдельных Google-таблиц менеджеров.
MANAGER_SPREADSHEETS_CONFIG=config/managers.php
MANAGER_SYNC_LOCK_FILE=var/sync-managers.lock

# Служебный 12-й столбец (L), следующий за видимыми данными, хранит стабильный ID сделки.
TECHNICAL_ID_COLUMN=12
TECHNICAL_ID_HEADER=Bitrix24 Deal ID

# Видимый столбец M со ссылкой на карточку сделки. Создается автоматически.
DEAL_LINK_COLUMN=13
DEAL_LINK_HEADER=Ссылка на сделку в Битрикс24

# Дополнительные видимые столбцы N:Q. Создаются автоматически.
DEAL_CREATED_COLUMN=14
DEAL_CREATED_HEADER=Дата создания сделки в Б24
DEAL_WON_DATE_COLUMN=15
DEAL_WON_DATE_HEADER=Дата перехода сделки в Успешно реализовано
DEAL_TYPE_COLUMN=16
DEAL_TYPE_HEADER=Тип сделки
INVOICE_DATE_COLUMN=17
INVOICE_DATE_HEADER=Дата выставлен счет

# Стадии, даты входа в которые читаются из истории движения сделки.
BITRIX24_INVOICE_STAGE_ID=PREPAYMENT_INVOICE
# Для основной воронки — WON; для дополнительной, например, C7:WON.
# Если оставить пустым, успешная стадия определяется из BITRIX24_STAGE_IDS.
BITRIX24_WON_STAGE_ID=

TIMEZONE=Europe/Moscow
SYNC_LOOKBACK_SECONDS=300
SYNC_STATE_FILE=var/state.json
SYNC_LOCK_FILE=var/sync.lock
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=info
